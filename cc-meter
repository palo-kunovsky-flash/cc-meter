def help_screen(cols):
    W = max(40, cols - 1)
    w = W - 1
    out = [f"{BOLD}{C_WHITE}cc-meter{RST}  {C_GREY}help — what every number means{RST}", ""]
    for title, meta, items in HELP:
        out += section(title, meta, w)
        for term, text in items:
            wrapped = textwrap.wrap(text, max(20, w - LABEL_W - 1)) or [""]
            for j, chunk in enumerate(wrapped):
                out.append(line(term if j == 0 else "", C_GREY + chunk + RST, w, WHITE))
        out.append("")
    out = [" " + l for l in out]
    out.append(" " + fit(f"{C_GREY}h{RST} {C_FAINT}or{RST} {C_GREY}Esc{RST} {C_FAINT}back to the dashboard{RST}", w))
    return [fit(l, W) for l in out]


def render(tr, lim, cst, args, win_h, now, cols):
    # One column short of the edge: a glyph in the last column leaves some
    # terminals in a pending-wrap state that eats the next line.
    W = max(40, cols - 1)
    pad_l = 1
    w = W - pad_l
    v = View(tr, lim, win_h, now)
    out = []
    left = f"{BOLD}{C_WHITE}cc-meter{RST}  {C_GREY}Claude Code usage{RST}"
    right = status_badge(cst) + f"  {C_FAINT}{dt.datetime.fromtimestamp(now):%H:%M:%S}{RST}"
    gap = w - vis_len(left) - vis_len(right)
    out.append(left + " " * gap + right if gap >= 2 else fit(right, w))
    out += status_rows(cst, w, now)
    out.append("")
    if w >= 150:  # wide: limits and throughput side by side
        lw, rw = split_w(w, 2, 6)
        out += columns([limits_section(v, lw) + [""] + today_section(v, lw), throughput_section(v, rw)], w, 6)
    else:
        out += limits_section(v, w) + [""] + throughput_section(v, w) + [""] + today_section(v, w)
    out.append("")
    out += breakdown_section(v, w)
    out = [" " * pad_l + l for l in out]
    keys = (f"{C_GREY}q{RST} {C_FAINT}quit{RST}  {C_GREY}↑↓{RST} {C_FAINT}scroll{RST}  "
            f"{C_GREY}w{RST} {C_FAINT}window {win_h}h{RST}  {C_GREY}r{RST} {C_FAINT}refresh{RST}  "
            f"{C_GREY}u{RST} {C_FAINT}fetch limits{RST}  {C_GREY}h{RST} {C_FAINT}help{RST}")
    out.append(" " + fit(keys, w))
    return [fit(l, W) for l in out]


# ── main loop ─────────────────────────────────────────────────────────────────
def main():
    ap = argparse.ArgumentParser(description="Live dashboard for global Claude Code usage.")
    ap.add_argument("-i", "--interval", type=float, default=5, help="transcript refresh, s (default 5)")
    ap.add_argument("-u", "--usage-interval", type=float, default=60,
                    help="poll the usage API when status-line data is older than this, s (default 60)")
    ap.add_argument("-w", "--window", type=int, default=2, help="throughput window, hours (default 2)")
    ap.add_argument("--once", action="store_true", help="print one frame and exit")
    args = ap.parse_args()

    os.makedirs(CACHE_DIR, exist_ok=True)
    win_h = args.window
    tr, lim, cst = Transcripts(), Limits(), ClaudeStatus()
    cst.refresh(time.time())
    first_run = not tr.files

    def progress(n, total):
        sys.stderr.write(f"\r\033[Kindexing transcripts {n}/{total}…")
        sys.stderr.flush()

    tr.refresh(time.time(), progress if first_run else None)
    if first_run:
        sys.stderr.write("\r\033[K")
    tr.save()
    lim.read_statusline()
    if time.time() - lim.fetched >= args.usage_interval:
        lim.poll(time.time())

    if args.once or not sys.stdout.isatty():
        cols = shutil.get_terminal_size((160, 50)).columns
        cst.wait(10)
        print("\n".join(render(tr, lim, cst, args, win_h, time.time(), cols)))
        return

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    signal.signal(signal.SIGWINCH, lambda *_: None)  # wakes select() to redraw
    # Alt screen, hidden cursor, wheel reporting (hold Option/Shift to select text).
    sys.stdout.write("\033[?1049h\033[?25l\033[?1000h\033[?1006h")
    try:
        tty.setcbreak(fd)
        next_tr, next_usage, scroll, show_help = 0.0, time.time() + 30, 0, False
        while True:
            now = time.time()
            if now >= next_tr:
                tr.refresh(now)
                next_tr = now + args.interval
                if now - tr.saved > 300:
                    tr.save()
            lim.check_account(now)
            if lim.need_poll:  # just switched accounts: the API knows the new numbers
                lim.poll(now)
            lim.read_statusline()
            cst.refresh(now)
            if now >= next_usage:
                if now - lim.fetched >= args.usage_interval:
                    lim.poll(now)
                next_usage = now + 30
            try:  # the live tty size; shutil would prefer a stale $COLUMNS
                size = os.get_terminal_size(sys.stdout.fileno())
            except OSError:
                size = shutil.get_terminal_size()
            frame = help_screen(size.columns) if show_help else \
                render(tr, lim, cst, args, win_h, now, size.columns)
            # Header and footer stay put; the panels between them scroll.
            body, view_h = frame[1:-1], max(1, size.lines - 2)
            scroll = max(0, min(scroll, len(body) - view_h))
            footer = frame[-1]
            if len(body) > view_h:  # position first, so a narrow window still shows it
                footer = (C_GREY + f" {scroll + 1}-{scroll + view_h} of {len(body)} " + RST + footer)
            footer = trunc(footer, size.columns - 1) if vis_len(footer) > size.columns - 1 else footer
            frame = [frame[0]] + body[scroll:scroll + view_h] + [footer]
            sys.stdout.write("\033[H" + "\n".join(l + "\033[K" for l in frame) + "\033[J")
            sys.stdout.flush()
            # Wake at least each second so the clock and countdowns stay live.
            wait = max(0.2, min(1.0, next_tr - time.time(), next_usage - time.time()))
            try:
                ready, _, _ = select.select([sys.stdin], [], [], wait)
            except InterruptedError:
                continue
            if ready:
                key = os.read(fd, 256).decode(errors="ignore")
                page = max(1, size.lines - 4)
                # Mouse wheel (SGR 1006): button 64 up, 65 down; may batch.
                scroll -= 3 * len(re.findall(r"\033\[<64;", key))
                scroll += 3 * len(re.findall(r"\033\[<65;", key))
                for seq, delta in (("\033[A", -1), ("\033[B", 1), ("\033[5~", -page), ("\033[6~", page)):
                    scroll += delta * key.count(seq)
                key = re.sub(r"\033\[[0-9;<]*[A-Za-z~]", "", key)  # plain keys only from here
                if "h" in key or "?" in key or (show_help and "\033" in key):
                    show_help, scroll = not show_help, 0
                    continue
                scroll += key.count("j") - key.count("k") + page * (key.count(" ") - key.count("b"))
                if "g" in key:
                    scroll = 0
                if "G" in key:
                    scroll = 10 ** 6
                if "q" in key or "\x03" in key:
                    break
                if "r" in key:
                    next_tr = 0
                if "u" in key:
                    lim.retry_at, next_usage = 0, 0
                    lim.fetched = 0  # force the API fallback once
                if "w" in key:
                    i = WINDOWS_H.index(win_h) if win_h in WINDOWS_H else -1
                    win_h = WINDOWS_H[(i + 1) % len(WINDOWS_H)]
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\033[?1000l\033[?1006l\033[?25h\033[?1049l")
        sys.stdout.flush()
        tr.save()


if __name__ == "__main__":
    main()
