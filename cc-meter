                      "cheaper and faster."),
        ("Cache", "Prompt cache over the window: hit = share of input read from cache; "
                  "read / written / uncached input tokens; lifetime = how long entries live "
                  "after their last use (Claude Code writes 5-minute or 1-hour entries)."),
        ("bars", "One bar per clock-aligned bucket (size in the section header); the scale "
                 "on the left is the chart ceiling. A gap means no requests then."),
    ]),
    ("Today & breakdown", "", [
        ("Today", "Totals since local midnight."),
        ("Breakdown", "Output, share and speed by model and by project (working directory; "
                      "subagent worktrees count toward the session that spawned them)."),
        ("Sessions", "Open sessions: ● busy / ○ idle, time of the last reply, and the cache: "
                     "'warm 42m' = its prompt cache lives 42 more minutes; 'expired' = the next "
                     "message re-writes the whole context (slower, more expensive)."),
        ("Status", "The header badge is status.claude.com; problems appear right under it."),
    ]),
    ("Refresh", "", [
        ("screen", "Redrawn every second (clock, countdowns)."),
        ("transcripts", "Re-read every 5 s, only the new bytes (-i to change)."),
        ("limits", "Whenever any session's status line renders; usage API after 60 s "
                   "without one (-u to change)."),
        ("status", "status.claude.com every 60 s."),
        ("storage", "~/.cache/cc-meter keeps 7-8 days: the transcript index (requests, ~10 MB) "
                    "and limit samples (for pace and forecasts)."),
    ]),
    ("Keys", "", [
        ("h  ?", "Toggle this help (Esc closes it)."),
        ("↑ ↓  j k", "Scroll; also the mouse wheel, PgUp/PgDn, space/b, g/G for top/bottom."),
        ("w", "Throughput window: 1, 2, 3, 6, 12, 24 h."),
        ("r  u", "Re-read transcripts now / ask the usage API for limits now."),
